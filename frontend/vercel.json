{
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/next"
    },
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": "api/model.tflite"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/py/predict",
      "dest": "api/index.py"
    },
    {
      "src": "/api/py/(.*)",
      "dest": "api/index.py"
    }
  ]
}
