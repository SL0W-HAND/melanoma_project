{
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/next"
    },
    {
      "src": "api/index.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/py/predict",
      "dest": "api/index.ts"
    },
    {
      "src": "/api/py/(.*)",
      "dest": "api/index.ts"
    }
  ]
}
